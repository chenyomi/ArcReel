.hero { height: 750rpx; background: #dddfda; }
.hero image { width: 100%; height: 100%; }
.code-only { display: grid; place-items: center; font-size: 84rpx; font-weight: 680; letter-spacing: -0.05em; }
.thumbs { white-space: nowrap; padding: 16rpx 32rpx 0; }
.thumb { width: 104rpx; height: 104rpx; margin-right: 12rpx; border: 2rpx solid transparent; }
.thumb.on { border-color: #121417; }
.pad { padding: 24rpx 32rpx 8rpx; display: flex; flex-direction: column; }
.code { font-size: 68rpx; }
.specs view { display: flex; justify-content: space-between; margin: 0 32rpx; padding: 22rpx 0; border-top: 1rpx solid #d0d4ce; }
.specs text:first-child { color: #5e676c; }
.note { display: block; margin: 20rpx 32rpx 0; white-space: pre-wrap; }
.bar {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 28rpx 32rpx 40rpx;
}
.call { background: #d0121a; color: #fff; height: 80rpx; font-size: 26rpx; }
